# Frontend public
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_TELEMETRY_DISABLED=1

# Frontend server
BACKEND_INTERNAL_URL=http://backend:8000/api/v1
APP_ORIGIN=http://localhost:3000

# Backend server
PROJECT_NAME=peii-backend
PROJECT_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=false
SQL_ECHO=false
LOG_JSON=true
SYSTEM_ACTOR_ID=00000000-0000-0000-0000-000000000001
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Database
DB_MODE=local
LOCAL_DATABASE_URL=postgresql+psycopg2://postgres:replace_me@postgres:5432/peii
SUPABASE_DATABASE_URL=postgresql+psycopg2://postgres:postgres@db.example.supabase.co:5432/postgres
POSTGRES_DB=peii
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_me
ADMINER_DEFAULT_SERVER=postgres

# Optional backend PostgreSQL integration tests. The normal suite skips integration tests
# without this value; use --require-postgres to fail instead of skipping.
# TEST_DATABASE_URL=postgresql+psycopg2://postgres:replace_me@localhost:5432/peii_test

# Supabase Auth. Keep the secret key server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
INITIAL_ADMIN_EMAIL=admin@example.gov.ph
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_FIRST_NAME=System
INITIAL_ADMIN_LAST_NAME=Administrator

# Email
# Supabase email templates use APP_ORIGIN and must be allowlisted in Supabase Auth.

# Rate limit
# Managed Redis configuration is intentionally deferred until the rate-limit implementation.

# Policy
# See docs/production-decisions.md and docs/privacy-and-retention.md before production use.
