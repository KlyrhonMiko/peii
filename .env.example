# Frontend public
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_TELEMETRY_DISABLED=1

# Frontend server
BACKEND_INTERNAL_URL=http://backend:8000/api/v1
APP_ORIGIN=http://localhost:3000
# Server-only HMAC key for the survey OAuth return state. Use a random value of at least
# 32 bytes; never rename it to NEXT_PUBLIC_* or expose it to the browser.
SURVEY_OAUTH_STATE_KEY=replace_with_a_random_32_byte_value

# Survey Google OAuth is configured in Supabase Auth with minimum scopes: openid email profile.
# Add this exact application callback to the Supabase Auth redirect allowlist:
# ${APP_ORIGIN}/auth/survey/google/callback
# Configure the Google OAuth client with the Google/Supabase provider callback as appropriate.

# Backend server
PROJECT_NAME=peii-backend
PROJECT_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=false
SQL_ECHO=false
LOG_JSON=true
SYSTEM_ACTOR_ID=00000000-0000-0000-0000-000000000001
# Local development uses HTTP and a local database. Production Supabase connections
# must set DATABASE_TLS_MODE=require, and Supabase SSL enforcement is enabled only
# after the deployed clients have been verified to use TLS.
# CORS accepts exact origins only: use the production HTTPS APP_ORIGIN value(s),
# never a wildcard, path, or trailing slash.
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Database
DB_MODE=local
DATABASE_TLS_MODE=disable
LOCAL_DATABASE_URL=postgresql+psycopg2://postgres:replace_me@postgres:5432/peii
SUPABASE_DATABASE_URL=postgresql+psycopg2://postgres:postgres@db.example.supabase.co:5432/postgres
POSTGRES_DB=peii
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_me
ADMINER_DEFAULT_SERVER=postgres

# Redis and traffic security. Local development may use Docker Redis and no trusted proxies.
# In production (DEBUG=false and DB_MODE=supabase), use either a complete HTTPS Upstash
# pair with its exact verified endpoint or a REDIS_URL using rediss://.
REDIS_URL=redis://redis:6379/0
# UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace_with_the_upstash_rest_token
REDIS_MAX_CONNECTIONS=32
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
RATE_LIMIT_ENABLED=true
# Required when rate limiting is enabled outside DEBUG mode; withdrawal limits use this client identity.
RATE_LIMIT_INCLUDE_CLIENT_IP=true
# Production requires fail_closed for Redis read failures.
RATE_LIMIT_READ_FAILURE_POLICY=fail_closed
RATE_LIMIT_KEY_HMAC_SECRET=replace_with_a_random_32_byte_value
# Dedicated HMAC key for browser-generated 256-bit withdrawal codes; required when DEBUG=false.
WITHDRAWAL_CODE_HMAC_SECRET=replace_with_a_dedicated_random_32_byte_value
# Server-only release flag shared by FastAPI and the Next.js server. Keep false for initial launch.
CSV_EXPORT_ENABLED=false
PUBLIC_SURVEY_READ_LIMIT=60
PUBLIC_SURVEY_READ_WINDOW_SECONDS=60
PUBLIC_SURVEY_READ_GLOBAL_LIMIT=6000
PUBLIC_SURVEY_READ_GLOBAL_WINDOW_SECONDS=60
PUBLIC_SURVEY_SUBMIT_LIMIT=10
PUBLIC_SURVEY_SUBMIT_WINDOW_SECONDS=60
PUBLIC_SURVEY_SUBMIT_GLOBAL_LIMIT=1000
PUBLIC_SURVEY_SUBMIT_GLOBAL_WINDOW_SECONDS=60
PUBLIC_SURVEY_WITHDRAWAL_CLIENT_LIMIT=10
PUBLIC_SURVEY_WITHDRAWAL_CLIENT_WINDOW_SECONDS=60
PUBLIC_SURVEY_WITHDRAWAL_GLOBAL_LIMIT=1000
PUBLIC_SURVEY_WITHDRAWAL_GLOBAL_WINDOW_SECONDS=60
# Google-authenticated respondent attestation limits.
GOOGLE_SURVEY_ATTEST_RATE_LIMIT=5
GOOGLE_SURVEY_ATTEST_RATE_WINDOW_SECONDS=60
# Portal limits use normalized identifiers only; the global breakers absorb shared BFF egress.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
LOGIN_GLOBAL_LIMIT=1000
LOGIN_GLOBAL_WINDOW_SECONDS=60
PASSWORD_RECOVERY_RATE_LIMIT=5
PASSWORD_RECOVERY_RATE_WINDOW_SECONDS=900
PASSWORD_RECOVERY_GLOBAL_LIMIT=1000
PASSWORD_RECOVERY_GLOBAL_WINDOW_SECONDS=900
MAX_REQUEST_BODY_BYTES=65536
TRUSTED_PROXY_HEADER=X-Forwarded-For
# Local default. For production, replace [] with the exact verified Render immediate
# proxy CIDRs; do not use broad RFC1918 ranges as production-ready values.
TRUSTED_PROXY_CIDRS=[]
TRUSTED_PROXY_MAX_HOPS=20
TRUSTED_PROXY_MAX_HEADER_BYTES=2048

# Public distribution policy defaults.
SURVEY_DISTRIBUTION_DEFAULT_EXPIRY_DAYS=30
SURVEY_DISTRIBUTION_MAX_EXPIRY_DAYS=30
# This is an example consent contract. Production must replace it with explicitly approved
# values before launch; the example/default values do not satisfy the launch gate.
PUBLIC_SURVEY_CONSENT_VERSION=2026-09-01
PUBLIC_SURVEY_PRIVACY_NOTICE=Before Google sign-in and consent, this survey discloses: your verified Google email and display name are stored with your response; authorized researchers can identify respondents; identity enables one Google account per survey; on respondent withdrawal, direct identity and answers are removed but a survey-scoped pseudonymous dedupe digest is retained so that account cannot submit again; administrative erasure clears the digest; short-lived proof PII is physically deleted by the external purge after expiry. This survey does not promise anonymity or confidentiality.
PUBLIC_SURVEY_PURPOSE=Program evaluation and research.
PUBLIC_SURVEY_RETENTION=Responses are retained according to the approved policy.
PUBLIC_SURVEY_CONTACT=privacy@example.gov.ph

# Optional backend PostgreSQL integration tests. The normal suite skips integration tests
# without this value; use --require-postgres to fail instead of skipping.
# TEST_DATABASE_URL=postgresql+psycopg2://postgres:replace_me@localhost:5432/peii_test

# Supabase Auth. Keep the secret key server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Google-authenticated identified survey respondents. Keep this HMAC secret dedicated and
# stable for the lifetime of every survey using dedupe; it must be random and at least 32 bytes.
GOOGLE_OAUTH_CLIENT_ID=replace_with_google_oauth_client_id
SURVEY_RESPONDENT_HMAC_SECRET=replace_with_a_dedicated_random_32_byte_value
# Default 300 seconds; production may not exceed 3600 seconds.
SURVEY_GOOGLE_SESSION_MAX_AGE_SECONDS=300
INITIAL_ADMIN_EMAIL=admin@example.gov.ph
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_FIRST_NAME=System
INITIAL_ADMIN_LAST_NAME=Administrator

# Email
# Supabase email templates use APP_ORIGIN and must be allowlisted in Supabase Auth.

# Provider actions are manual launch prerequisites, not application defaults: configure Google
# Auth callbacks and scopes; schedule the external purge at least daily for live responses and
# expired proof rows; rotate any credentials exposed during development; remove the public role
# from the Data API exposed schemas/tables; deploy and verify database TLS, then enable Supabase
# SSL enforcement; configure Vercel and Render HSTS; and verify provider redaction,
# no-store behavior, backups/PITR, and the external retention schedule.
# Do not place production secrets in this example file.
# Policy and manual verification checklist
# See docs/production-decisions.md and docs/privacy-and-retention.md before production use.
